# Backend
PORT=4000
# Local Node dev (Postgres in Docker): use localhost
DATABASE_URL=postgresql://spark:spark_dev_password@localhost:5432/spark_appointments
# Full Docker stack: compose overrides DATABASE_URL to postgres://...@postgres:5432/...
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# OpenRouter (https://openrouter.ai/) — optional; mock AI used when unset
OPENROUTER_API_KEY=
# Low-cost paid options: openai/gpt-4o-mini | anthropic/claude-3-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_TITLE=Spark Book
OPENROUTER_APP_URL=http://localhost:3000

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws
